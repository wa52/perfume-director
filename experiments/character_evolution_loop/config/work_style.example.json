    "hero poster composition for ordinary daily scenes"
  ],
  "locked_dimensions": {
    "medium": "2D animation",
    "line_language": "clean controlled linework",
    "shading": "restrained cel shading",
    "proportion_system": "natural human proportions",
    "material_rendering": "graphic rather than photorealistic",
    "default_camera": "character-readable medium/half-body framing",
    "background_density": "supportive, not dominant"
  },
  "editable_dimensions": [
